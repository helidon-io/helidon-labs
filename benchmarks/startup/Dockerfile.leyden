# syntax=docker/dockerfile:1.7-labs
FROM helidon/benchmark-startup-base AS benchmark

WORKDIR /usr/share

ENV JDK_URL="https://download.java.net/java/early_access"
ENV DOWNLOAD_URL="${JDK_URL}/leyden/1/openjdk-26-leydenpremain+1_linux-x64_bin.tar.gz"
ENV JAVA_HOME=/usr/share/jdk-26

# Install Leyden EA
RUN wget -O leyden-jdk.tar.gz ${DOWNLOAD_URL} && \
    tar zxf ./leyden-jdk.tar.gz -C /usr/share && \
    ln -sf $JAVA_HOME/bin/java /bin/ && \
    ln -sf $JAVA_HOME/bin/jcmd /bin/ && \
    ln -sf $JAVA_HOME/bin/jps /bin/

WORKDIR /helidon

ARG FLAVOR=mp
ENV FLAVOR=$FLAVOR

ADD ${FLAVOR}-bench-app/pom.xml .
ADD ${FLAVOR}-bench-app/pokemons.mv.db .
ADD ${FLAVOR}-bench-app/src src

ARG WARMUP_CACHEBUST=1

# Do the snapshot
RUN <<END_OF_SCRIPT
cat <<EOF > after-warmup.sh
#!/bin/bash -e
# Trigger the checkpoint
kill \$PID

# Wait until the process is actually terminated
while kill -0 "\$PID" 2>/dev/null; do
  sleep 0.05
done

echo "Killed, creating the aot cache"

# Use the configuration to create the cache, in the file benchmark.aot
java -XX:AOTMode=create \
-XX:AOTConfiguration=benchmark.aotconf \
-Xlog:aot \
-XX:AOTCache=./benchmark.aot -jar ./target/benchmark.jar |& tee helidon-run.log

EOF
END_OF_SCRIPT

# AOT build and warmup
RUN <<END_OF_SCRIPT
cat <<EOF > aot-build.sh
#!/bin/bash
mvn package -DskipTests

java -version
java -XX:+UnlockExperimentalVMOptions -XX:+PrintFlagsFinal -version

java \
-XX:AOTMode=record \
-XX:AOTConfiguration=benchmark.aotconf \
-jar ./target/benchmark.jar |& tee helidon-warmup.log &

PID="\$(jcmd | grep ".jar" | awk '{print \$1}')"

source warmup.sh
EOF
END_OF_SCRIPT

# Run AOT script and measure time
RUN /usr/bin/time -f "$AOT_TIME_FORMAT" -o $AOT_TIME_FILE bash aot-build.sh

# Runtime benchmark
RUN <<END_OF_SCRIPT
cat <<EOF > run.sh
#!/bin/bash -e

ls -la .
ls -la ./target

java \
-XX:AOTCache=benchmark.aot -XX:AOTMode=on -Xlog:aot \
-jar ./target/benchmark.jar |& tee helidon-run.log &

PID="\$(jcmd | grep "jar" | awk '{print \$1}')"

source benchmark.sh
EOF
END_OF_SCRIPT

CMD ["/bin/bash", "run.sh"]

